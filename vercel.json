{
  "version": 2,
  "buildCommand": "npm install --prefix frontend && npm install --prefix backend && npm run --prefix frontend build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "backend/api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/backend/api/contact"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
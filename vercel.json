{
  "version": 2,
  "buildCommand": "npm install --prefix frontend && npm run --prefix frontend build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/contact.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}